{
  "name": "apex-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "tsx scripts/build-tokens.ts",
    "predev": "npm run tokens",
    "dev": "next dev",
    "prebuild": "npm run tokens",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "guide": "playwright test -c docs/guide/playwright.config.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "nodemailer": "$nodemailer"
  }
}
