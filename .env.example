# ──────────────────────────────────────────────────────────────────────────────────────────
# Apex CRM settings. Copy to .env.local for development; on Vercel, add the same names under
# Project › Settings › Environment Variables. Full walkthrough: DEPLOY.md.
# Never commit real values: .env.local is git-ignored.
# ──────────────────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────────────────
# Neon Postgres connection string. Development: your "dev" branch. Production: the "main"
# branch (Neon › Connect › pooled connection string).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/apex?sslmode=require

# Signs session cookies and one-time links. 32+ random characters, different per environment.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Public address of the app, used in emailed links (https://crm.yourcompany.com).
# Optional in development (the request's host is used).
APP_URL=

# ── Strongly recommended in production ────────────────────────────────────────────────────
# Encrypts two-step login secrets at rest: 32 bytes, base64 (same command as AUTH_SECRET).
# If unset, a key is derived from AUTH_SECRET. Never change it once people use two-step login.
ENCRYPTION_KEY=

# Protects the daily job (/api/cron/daily). Vercel sends it automatically to cron calls.
CRON_SECRET=

# Outgoing email: password reset, confirmations, invitations, invoices, reminders.
# Leave SMTP_HOST empty in development: emails are kept at http://localhost:3000/api/dev/mail
# Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Apex CRM <no-reply@example.com>"

# File attachments: a PRIVATE Vercel Blob store (Vercel › Storage › Blob). Vercel fills this in
# when you connect the store to the project. Without it, development stores files in .data/.
BLOB_READ_WRITE_TOKEN=

# Shown on the Privacy policy and Terms pages.
OPERATOR_NAME="Your company name"
CONTACT_EMAIL=privacy@example.com

# ── Optional ──────────────────────────────────────────────────────────────────────────────
# Sign in with Google (the button appears when both are set).
# Google Cloud Console › APIs & Services › Credentials › OAuth client ID (Web application)
# Authorised redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Server-error alerts: a Slack/Discord/Teams incoming-webhook URL and/or an email address.
ALERT_WEBHOOK_URL=
ALERT_EMAIL=

# Development only: password of the seeded owner (owner@apex.test) for `npm run db:seed`,
# and the Chrome/Edge used for PDFs if it is not found automatically.
SEED_PASSWORD=
CHROME_PATH=
