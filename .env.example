# Neon Postgres connection string (use the "dev" branch locally)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/apex?sslmode=require

# Auth.js: signs the session cookie. Generate with `npx auth secret` (required in production)
AUTH_SECRET=
# Password given to the seeded owner (owner@apex.test) by `npm run db:seed`; dev only
SEED_PASSWORD=
