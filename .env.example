# Neon Postgres connection string (use the "dev" branch locally)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/apex?sslmode=require

# Auth.js: signs the session cookie. Generate with `npx auth secret` (required in production)
AUTH_SECRET=
# Password given to the seeded owner (owner@apex.test) by `npm run db:seed`; dev only
SEED_PASSWORD=

# Public address of the app, used in emailed links (e.g. https://crm.example.com). Optional in dev.
APP_URL=

# Outgoing email (password reset, email confirmation). Leave SMTP_HOST empty in development:
# emails are then kept in a local outbox at http://localhost:3000/api/dev/mail
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-letter app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Apex CRM <no-reply@example.com>"

# Sign in with Google (optional; the button appears when both are set).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorised redirect URI: <APP_URL>/api/auth/callback/google  (dev: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
